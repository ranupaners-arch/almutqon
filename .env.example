# Kredensial database — salin file ini menjadi .env lalu isi nilai aslinya.
# JANGAN commit .env ke repositori.
DB_HOST=127.0.0.1
DB_NAME=db_almutqon-website
DB_USER=root
DB_PASS=

# --- Donasi (Opsi B: transfer manual, tanpa gateway) ---
# Ganti dengan data rekening / QRIS lembaga yang sebenarnya.
# Plus kode unik 010 sebelum menampilkan instruksi transfer.
DONASI_BANK_NAMA=
DONASI_BANK_BANK=BSI
DONASI_BANK_NOMOR=
DONASI_EWALLET_TIPE=DANA
DONASI_EWALLET_NAMA=
DONASI_EWALLET_NOMOR=
DONASI_QRIS_GAMBAR=/assets/QRIS.png
# Nomor rekening per bank (server tujuan + kode antarbank otomatis: BSI 451, BRI 002, KROM 459, SeaBank 535).
DONASI_BANK_BSI_NOMOR=
DONASI_BANK_BRI_NOMOR=
DONASI_BANK_KROM_NOMOR=
DONASI_BANK_SEABANK_NOMOR=
# Nomor e-wallet per provider (ShopeePay/DANA/GoPay).
DONASI_EWALLET_SHOPEEPAY_NOMOR=
DONASI_EWALLET_DANA_NOMOR=
DONASI_EWALLET_GOPAY_NOMOR=

# --- Google OAuth (Masuk dengan Google) ---
# Client ID & Secret dari Google Cloud Console (OAuth 2.0 Client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: override redirect URI (default dihitung dari URL saat ini).
GOOGLE_REDIRECT_URI=

# --- SMTP (Gmail App Password) — kirim email reset password ---
# Wajib: aktifkan 2FA di akun Gmail, lalu buat App Password 16 karakter.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Al-Mutqon
MAIL_FROM=
APP_DEBUG=false

# --- WhatsApp Server-Side (notifikasi pendaftaran, LUNAS, reminder) ---
WA_API_URL=
WA_API_TOKEN=
WA_ENABLED=true
# Kunci cron reminder agar URL tidak bisa dipicu sembarang orang. JAGA RAHASIA.
CRON_SECRET=
# Basis URL publik untuk link di pesan WA.
APP_URL=http://almutqon.test

# --- Verifikasi dokumen (API internal verif.almutqon v1). JAGA RAHASIA. ---
VERIF_API_URL=https://verif.example.com
VERIF_API_TOKEN=